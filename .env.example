# =================================================================
# 1. CONFIGURAÇÕES DE SISTEMA E AMBIENTE
# =================================================================
# Define o contexto da aplicação (PRODUCTION, DEV ou TEST)
AMBIENTE=

# Tempo de vida do cache em segundos
CACHE_TTL=


# =================================================================
# 2. SEGURANÇA E ACESSO
# =================================================================
# Domínios permitidos para requisições CORS (separados por vírgula)
DOMINIOS_PERMITIDOS=

# Chaves de autenticação interna para a API (separadas por vírgula)
API_KEYS_PERMITIDAS=


# =================================================================
# 3. BANCO DE DADOS
# =================================================================
# String de conexão (Ex: mysql+mysqlconnector://user:pass@host:port/db)
DB_CONNECT=

# Validação prévia de conexão (true/false)
DB_POOL_PRE_PING=

# Tempo de reciclagem do pool de conexões em segundos
DB_POOL_RECYCLE=


# =================================================================
# 4. INTEGRAÇÃO PODIO (OGX)
# =================================================================
# Credenciais do App de intercâmbios (OGX) no Podio
CLIENT_ID=
CLIENT_SECRET=
APP_ID=
APP_TOKEN=


# =================================================================
# 5. INTEGRAÇÃO PLATAFORMA EXPA (AIESEC GIS) & APPSCRIPT
# =================================================================
# Token de autenticação da plataforma EXPA (GIS)
TOKEN_EXPA=

# Endpoint do Google Apps Script
APPSCRIPT_EXPA=